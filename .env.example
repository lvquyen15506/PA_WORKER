# Sao chép thành .env bằng:  python scripts/make_env.py
# Không commit .env. Hai khóa FIELD_ENCRYPTION_KEY và HASH_KEY sinh một lần khi cài,
# KHÔNG nằm trong file sao lưu; hãy cất bản sao ở nơi riêng (USB hoặc giấy niêm phong).
# Mất khóa là mất dữ liệu đã mã hóa.

SECRET_KEY=
# Danh sách cách nhau bằng dấu phẩy. Muốn máy khác trong mạng LAN truy cập thì thêm IP máy chủ.
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (Docker). Bỏ trống POSTGRES_HOST để chạy thử bằng SQLite không cần Docker.
POSTGRES_DB=pa_worker
POSTGRES_USER=pa_worker
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

FIELD_ENCRYPTION_KEY=
HASH_KEY=

# Tùy chọn, tắt mặc định. Chỉ dùng khi Admin bật API OCR ngoài trong Cài đặt.
EXTERNAL_OCR_API_KEY=

# 1 = bật chế độ gỡ lỗi (chỉ khi phát triển). Bản cài cho khách luôn để 0.
DEBUG=0

# 1 = bản Demo (được nạp dữ liệu giả lập bằng seed_demo); 0 = bản Thật (dữ liệu của doanh nghiệp,
# seed_demo bị chặn). make_env.py hỏi và ghi giá trị này khi cài.
DEMO_MODE=0

# 1 = đã có reverse proxy cấp HTTPS phía trước (cookie Secure, HSTS). Bản bàn giao chạy HTTP: để 0.
HTTPS=0

# Cổng truy cập trên máy chủ (mặc định 8000). Đổi thì phải mở cổng mới trên tường lửa.
PA_PORT=8000
